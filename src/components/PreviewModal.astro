---
// PDF 預覽 Modal：iframe 顯示 blob URL，附下載與關閉按鈕
---

<div
  id="preview-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
>
  <div class="flex w-full max-w-2xl md:max-w-4xl flex-col overflow-hidden rounded-2xl bg-surface shadow-2xl h-[90dvh] max-h-[90dvh] md:h-[95dvh] md:max-h-[95dvh]">
    <!-- 標題列 -->
    <div class="flex items-center justify-between border-b border-border px-5 py-3">
      <div>
        <p class="text-sm font-semibold text-primary">PDF 預覽</p>
        <p class="text-xs text-muted">確認內容後再下載</p>
      </div>
      <div class="flex items-center gap-2">
        <!-- 在新分頁開啟（iOS Safari 等不支援 iframe PDF 的備案） -->
        <a
          id="preview-newtab-link"
          href="#"
          target="_blank"
          rel="noopener"
          class="hidden rounded-lg px-3 py-2 text-xs text-accent ring-1 ring-border hover:bg-gray-50"
        >
          在新分頁開啟
        </a>
        <!-- 下載按鈕 -->
        <button
          id="preview-download-btn"
          type="button"
          class="flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white hover:bg-primary/90 active:scale-95 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
          下載 PDF
        </button>
        <!-- 關閉按鈕 -->
        <button
          id="preview-close-btn"
          type="button"
          class="rounded-lg p-2 text-muted hover:bg-gray-100 hover:text-text transition"
          aria-label="關閉預覽"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- iframe PDF 顯示區 -->
    <iframe
      id="preview-iframe"
      class="w-full flex-1 min-h-[480px] md:min-h-0 bg-gray-100"
      style="border: none;"
      title="PDF 預覽"
    ></iframe>
  </div>
</div>
